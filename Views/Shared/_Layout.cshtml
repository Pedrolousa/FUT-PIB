<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FUT PIB</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index">
            <span class="ball">⚽</span> FUT PIB
        </a>

        <nav>
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (User.IsInRole(nameof(UserRole.Admin)))
                {
                    <a asp-controller="Admin" asp-action="Index">Painel</a>
                    <a asp-controller="Admin" asp-action="Ratings">Notas</a>
                }
                else
                {
                    <a asp-controller="Player" asp-action="Index">Jogadores</a>
                }

                <span class="hello">Olá, @User.Identity.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                    @Html.AntiForgeryToken()
                    <button class="link-button" type="submit">Sair</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login">Entrar</a>
                <a class="nav-cta" asp-controller="Account" asp-action="Register">Criar conta</a>
            }
        </nav>
    </header>

    <main class="container">
        @if (TempData["Success"] is string success)
        {
            <div class="alert success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert error">@error</div>
        }

        @RenderBody()
    </main>

    <footer>
        FUT PIB • Times equilibrados, resenha garantida.
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
